# Default demo mode is offline and simulated. No credentials are needed.
MODE=demo
PORT=4242
LOCAL_ORIGIN=http://127.0.0.1:4242
API_BASE_URL=https://api.openswitch.io
SDK_URL=https://sdk.openswitch.io/HyperLoader.js

# Sandbox only: supply separately provisioned test credentials locally.
# An administrator must verify endpoint, merchant/profile, routing and provider
# test mode before changing MODE=sandbox and SANDBOX_CONFIRMED=yes.
# Hostnames, profile names and key prefixes do not establish sandbox isolation.
# API_KEY=replace-with-test-secret-key
# PUBLISHABLE_KEY=replace-with-test-publishable-key
# PROFILE_ID=replace-with-test-profile
# SANDBOX_CONFIRMED=yes
# STATE_DIR=/absolute/path/outside/web-starter/sandbox-state

# Demo state defaults to the OS temp directory. Sandbox requires STATE_DIR.
# Return URL is always LOCAL_ORIGIN + /return; RETURN_URL is unsupported.
# Timeout is 10 seconds. No automatic financial retries are performed.
